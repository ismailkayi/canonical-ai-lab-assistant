# MicroCloud demo settings
# Copy this file to demo.conf and fill in the three "REQUIRED" values:
#   cp demo.conf.example demo.conf
# demo.conf is ignored by git, so your keys stay on this machine.
# Use plain KEY=value lines (no spaces around "=").

# ---------------------------------------------------------------------------
# AI co-presenter (OpenRouter)                                       REQUIRED*
# Get a key at https://openrouter.ai/keys
# Any model listed at https://openrouter.ai/models works.
# (*The demo still runs without a key; you just get built-in narration.)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# ---------------------------------------------------------------------------
# Landscape (step 3)                                                 REQUIRED
# Each instance is attached to Ubuntu Pro (PRO_TOKEN below) before it registers.
# Landscape SaaS:     set LANDSCAPE_ACCOUNT_NAME and leave LANDSCAPE_FQDN empty.
# Self-hosted:        set LANDSCAPE_FQDN (e.g. landscape.example.com);
#                     the account name is then "standalone".
# The registration key is set in Landscape under Settings (optional on
# self-hosted servers that do not use one).
# ---------------------------------------------------------------------------
LANDSCAPE_ACCOUNT_NAME=
LANDSCAPE_FQDN=
LANDSCAPE_REGISTRATION_KEY=
# Self-hosted with a self-signed certificate: path to the server's .pem file
LANDSCAPE_SSL_CERT=

# ---------------------------------------------------------------------------
# Ubuntu Pro (step 3 attaches it before Landscape; step 4's USG needs it) REQUIRED
# Get a token at https://ubuntu.com/pro/dashboard (free for personal use).
# ---------------------------------------------------------------------------
PRO_TOKEN=

# ---------------------------------------------------------------------------
# Demo shape — sized to fit in about 10 GiB of RAM, for a laptop that is
# also running a desktop, browser and IDE. The narration follows these numbers.
#
#   ~10 GiB free:  NODE_COUNT=3  NODE_MEMORY=3GiB  INSTANCE_TYPE=container  INSTANCE_COUNT=1  (default)
#   ~24 GiB free:  NODE_COUNT=5  NODE_MEMORY=4GiB  INSTANCE_TYPE=vm  INSTANCE_MEMORY=1GiB
#   ~48 GiB free:  NODE_COUNT=10 NODE_MEMORY=4GiB  INSTANCE_TYPE=vm  INSTANCE_COUNT=5
#
# NODE_COUNT must be at least 3 (Ceph and the cluster need three members).
# The cluster VMs can use up to NODE_COUNT × NODE_MEMORY of RAM.
# Containers share each member's kernel, so they cost ~200 MiB instead of ~1 GiB;
# Landscape (step 3) and USG (step 4) work the same in them.
# ---------------------------------------------------------------------------
NODE_COUNT=3             # MicroCloud cluster members (VMs on this host)
NODE_CPU=2
NODE_MEMORY=3GiB
NODE_ROOT_DISK=15GiB
NODE_CEPH_DISK=15GiB

# One instance by default: the 3 VMs are pooled into one cloud, and that one
# instance is registered in Landscape (step 3) and hardened with USG (step 4).
# Each extra instance needs its own Landscape seat and Ubuntu Pro seat
# (free Pro tokens cover 5 machines). Raise it to show the cloud
# spreading several instances across members.
INSTANCE_COUNT=1         # Workload instances provisioned on MicroCloud
INSTANCE_TYPE=container  # container (light) or vm (needs ~1 GiB each + nested virtualization)
INSTANCE_CPU=1
INSTANCE_MEMORY=512MiB

UBUNTU_IMAGE=ubuntu:24.04
# Snap channels installed on the cluster members (step 1). Step 1 downloads
# them once on this host (into cache/) and copies them into every VM.
LXD_CHANNEL=5.21/stable
MICROCEPH_CHANNEL=squid/stable
MICROOVN_CHANNEL=24.03/stable
MICROCLOUD_CHANNEL=2/stable
UPLINK_SUBNET=10.20.0    # first three octets of the MicroCloud uplink network

# Print every command a step runs, including background ones (yes / no).
# The key commands are always printed.
TRACE_COMMANDS=yes

USG_INSTANCE=1           # which instance to harden in step 4
USG_PROFILE=cis_level1_server
# one = fix only USG_RULE and re-check just that rule (default: fast, light).
# all = fix every failing rule in one pass (big score jump, much slower and
#       heavier: a full remediation plus a second full audit), except a few that
#       would break the demo (see SKIP_RULES in scripts/usg_tools.py).
USG_FIX=one
# Extra rules to leave alone with USG_FIX=all (space-separated, * wildcards OK).
USG_SKIP_RULES=
# Rule for USG_FIX=one. Leave empty to auto-pick the first failing rule from a safe list.
USG_RULE=sshd_disable_root_login
